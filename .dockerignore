# Allow only build inputs. Local data and configuration never enter the context.
**
!Dockerfile
!.dockerignore
!LICENSE
!package.json
!scripts/
!scripts/generate-app-version.mjs
!assets/
!assets/icons/
!assets/icons/app-logo.svg

!frontend/
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/tsconfig*.json
!frontend/vite.config.ts
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**

!backend/
!backend/package.json
!backend/package-lock.json
!backend/tsconfig.json
!backend/src/
!backend/src/**
!backend/drizzle/
!backend/drizzle/**

# Exclude generated or sensitive files even inside an allowed source directory.
**/.env
**/.env.*
**/*.key
**/*.pem
**/node_modules
**/dist
**/src/generated/
**/*.db
**/*.db-*
**/*.sqlite*
**/*.log
