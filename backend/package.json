{
  "name": "inventory-manager-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node ../scripts/generate-app-version.mjs backend",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "pretypecheck": "node ../scripts/generate-app-version.mjs backend",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json && tsc -p test/tsconfig.json",
    "lint": "eslint .",
    "pretest": "node ../scripts/generate-app-version.mjs backend",
    "test": "node --import tsx --test test/*.test.ts",
    "prebuild": "node ../scripts/generate-app-version.mjs backend",
    "build": "tsc",
    "format:check": "prettier --check .",
    "db:generate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/db/migrate.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "rotating-file-stream": "^3.2.10",
    "sharp": "^0.35.5",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
