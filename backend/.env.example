# Absolute storage paths only. With these overrides unset, the storage root is
# InventoryData/ in the repository, independently of the working directory.
# Its children are config/, data/, backups/, logs/, and temp/.
# SQLite defaults to data/inventory.db and managed files to data/attachments/.
# config/settings.json can select data/backup directories at startup.
# INVENTORY_DB_PATH overrides the SQLite path selected by those settings.
# INVENTORY_DATA_DIR=/absolute/path/to/inventory-data
# INVENTORY_DB_PATH=/absolute/path/to/inventory.db

INVENTORY_HOST=127.0.0.1
INVENTORY_PORT=8000
INVENTORY_LOG_LEVEL=INFO
