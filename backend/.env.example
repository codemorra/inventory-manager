# Absolute storage paths only. With these overrides unset, data is stored in
# InventoryData/node/ in the repository root, independently of the working directory.
# INVENTORY_DATA_DIR=/absolute/path/to/inventory-data
# INVENTORY_DB_PATH=/absolute/path/to/inventory.db

INVENTORY_HOST=127.0.0.1
INVENTORY_PORT=8000
INVENTORY_LOG_LEVEL=INFO
