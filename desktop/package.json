{
  "name": "inventory-manager-desktop",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/start.mjs",
    "pretypecheck": "node ../scripts/generate-app-version.mjs desktop",
    "typecheck": "tsc --noEmit && tsc -p test/tsconfig.json",
    "lint": "eslint .",
    "prebuild": "node ../scripts/generate-app-version.mjs desktop",
    "build": "tsc",
    "pretest": "node ../scripts/generate-app-version.mjs desktop",
    "test": "node --import tsx --test test/*.test.ts",
    "prepare:runtime": "node scripts/prepare.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "electron": "^45.1.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
